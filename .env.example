# ChurchTools host (no trailing slash, no /api suffix). No hardcoded default:
# the host is normally captured at `ct auth login --host <url>` and stored with
# the token. Set this to OVERRIDE the stored host (CI / one-off / test instance).
CT_HOST=https://mychurch.church.tools

# Personal login token (ChurchTools → user settings). Prefer `ct auth login`,
# which stores host + token together in the macOS Keychain. This env var is for
# CI / one-off use and takes precedence over the stored token.
CT_LOGINTOKEN=
