// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`golden export > renders byte-stable campuses.tf 1`] = `
"resource "churchtools_campus" "aussenstelle" {
  name   = "Aussenstelle $\${nord}"
  shorty = "AS"

  lifecycle {
    prevent_destroy = true
  }
}

resource "churchtools_campus" "hauptstandort" {
  name   = "Hauptstandort"
  shorty = "HS"
}

resource "churchtools_campus" "zweigstelle" {
  name   = "Zweigstelle"
  shorty = "ZW"
}
"
`;

exports[`golden export > renders byte-stable comment-viewers.tf 1`] = `
